{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deepdrinks-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/videos", "/api/videos/", "/about", "/about/"]
  },
  "durable_objects": {
    "bindings": [{ "name": "VIDEO_FEED", "class_name": "VideoFeed" }]
  },
  "exports": {
    "VideoFeed": { "type": "durable-object", "storage": "sqlite" }
  }
}
